{
  "name": "compass-organiser",
  "version": "2.0.0",
  "private": true,
  "description": "Scout group organiser — Next.js on Vercel Hobby",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "dotenv -e .env.local -- drizzle-kit push",
    "db:generate": "dotenv -e .env.local -- drizzle-kit generate",
    "db:seed": "dotenv -e .env.local -- tsx scripts/seed.ts",
    "db:migrate-responsible": "dotenv -e .env.local -- tsx scripts/migrate-task-responsible.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@apollo/client": "^3.13.8",
    "@apollo/server": "^4.12.2",
    "@as-integrations/next": "^3.2.0",
    "@clerk/nextjs": "^7.7.5",
    "@neondatabase/serverless": "^1.0.1",
    "@vercel/config": "^0.0.24",
    "bcryptjs": "^3.0.2",
    "drizzle-orm": "^0.44.4",
    "find-dom-node-polyfill": "^1.0.3",
    "graphql": "^16.11.0",
    "jsonwebtoken": "^9.0.2",
    "jwt-decode": "^4.0.0",
    "next": "^15.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "semantic-ui-css": "^2.5.0",
    "semantic-ui-react": "^2.1.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.17.1",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "dotenv-cli": "^8.0.0",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
