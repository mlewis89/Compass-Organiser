DATABASE_URL=
JWT_SECRET=
JWT_EXPIRY=7d
DEFAULT_GROUP_SLUG=default
# Comma-separated emails treated as GroupLeader until a real role is assigned.
# Needed because brand-new Clerk sign-ups get a membership with no roles, and
# a role must exist before one can be assigned via the member UI.
GROUP_ADMIN_EMAILS=
# Also used server-side to invite new members from the Members page
# (clerkClient().invitations.createInvitation). Clerk sends the invite
# email itself — no separate email provider is configured in this app.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Your app's own base URL (no trailing slash), e.g. https://compass-organiser.vercel.app
# or http://localhost:3000. Used to build the invitation redirectUrl so invited
# members land on this app's own /sign-up page instead of Clerk's Account Portal
# (*.accounts.dev). Falls back to VERCEL_URL, then localhost, if unset.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/
