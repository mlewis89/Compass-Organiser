DATABASE_URL=
JWT_SECRET=
JWT_EXPIRY=7d
DEFAULT_GROUP_SLUG=default
# Comma-separated emails treated as GroupLeader until a real role is assigned.
# Needed because brand-new Clerk sign-ups get a membership with no roles, and
# a role must exist before one can be assigned via the member UI.
GROUP_ADMIN_EMAILS=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/
